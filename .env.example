# Database Configuration (optional, defaults to SQLite)
# DATABASE_URL=postgresql://user:password@localhost:5432/ochre_db

# Razorpay Payment Integration
# Get these from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Email Configuration (optional)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_app_password
# CONTACT_EMAIL=contact@example.com

# Analytics (optional)
# GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
# META_PIXEL_ID=your_pixel_id

# OTP Provider (optional, for SMS functionality)
# OTP_PROVIDER_BACKEND=msg91
# OTP_PROVIDER_API_KEY=your_api_key

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=your_client_id
# GOOGLE_CLIENT_SECRET=your_client_secret

# Environment
# ENVIRONMENT=local  # Options: local, test, live
